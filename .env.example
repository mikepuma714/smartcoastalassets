# Neon Postgres (Vercel Marketplace). Stores inquiries, consent records and opt-outs.
DATABASE_URL=

# Resend: emails the team on every inquiry.
RESEND_API_KEY=
# Comma-separated list of team inboxes to notify.
INQUIRY_NOTIFY_TO=JeffBeggins@C21be.com
# Must be a sender on a domain verified in Resend.
INQUIRY_FROM_EMAIL=Smart Coastal Assets <inquiries@smartcoastalassets.com>

# Long random strings (32+ chars).
# Password for /api/compliance/export (browser login: any username + this password).
COMPLIANCE_EXPORT_TOKEN=
# Bearer token your SMS / dialer / AI provider uses to POST STOP opt-outs to /api/optout.
OPTOUT_WEBHOOK_SECRET=

# Optional: free ArcGIS Location Platform key for the satellite map tiles.
NEXT_PUBLIC_ARCGIS_API_KEY=

# Set to "true" after legal counsel approves the Privacy Policy, Terms and consent language.
NEXT_PUBLIC_LEGAL_APPROVED=
